{
  "name": "@floor-fifty/server",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Authoritative Colyseus room server running the shared Planck race simulation.",
  "scripts": {
    "dev": "vite-node --watch src/dev.ts",
    "build": "pnpm -w content:check --verify-artifact && vite build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.18",
    "@colyseus/schema": "^5.0.36",
    "@colyseus/ws-transport": "^0.18.4",
    "@floor-fifty/shared": "workspace:*"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.5",
    "@colyseus/testing": "^0.18.6",
    "@colyseus/tools": "^0.18.7",
    "@floor-fifty/content": "workspace:*"
  }
}
