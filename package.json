{
  "name": "floor-fifty",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Four-player authoritative browser port of Floor Fifty built on PixiJS.",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings",
    "test": "vitest run && pnpm test:perf",
    "test:perf": "vitest run --config apps/server/vitest.perf.config.ts",
    "test:watch": "vitest",
    "test:server": "vitest run --project server",
    "test:client": "vitest run --project client",
    "test:e2e": "playwright test --project=desktop --project=mobile-portrait --project=mobile-landscape --project=tablet-portrait --project=responsive --project=webkit-gamepad --project=webkit-replay",
    "test:smoke": "playwright test --config playwright.release.config.ts",
    "test:e2e:budget": "playwright test --project=frame-budget --project=frame-budget-portrait --project=frame-budget-landscape --project=frame-budget-tablet --workers=1",
    "typecheck": "pnpm i18n:compile && pnpm -r typecheck && tsc -p tsconfig.tests.json",
    "i18n:compile": "vite-node tools/i18n/compile.ts",
    "fonts:subset": "vite-node packages/asset-contract/tools/subset-fonts.ts",
    "i18n:draft": "vite-node tools/i18n/bin.ts draft",
    "i18n:export": "vite-node tools/i18n/bin.ts export",
    "i18n:import": "vite-node tools/i18n/bin.ts import",
    "i18n:check": "vite-node tools/i18n/bin.ts check",
    "i18n:lengths": "vite-node tools/i18n/bin.ts lengths",
    "prebuild": "pnpm content:check --verify-artifact",
    "build": "pnpm -r build",
    "release:check": "vite-node deploy/tools/release-check-cli.ts",
    "dev": "pnpm content:build && VITE_HOST=0.0.0.0 FLOOR_FIFTY_TELEMETRY=1 pnpm -r --parallel dev",
    "netlab": "FLOOR_FIFTY_NETLAB=1 vitest run --project server tests/server/netcode-lab.test.ts",
    "bench:server": "node --expose-gc node_modules/vite-node/vite-node.mjs tools/server-bench.ts",
    "traces:record": "vite-node tests/shared/support/record-traces.ts",
    "content:check": "vite-node packages/content/bin/content.ts check",
    "content:build": "vite-node packages/content/bin/content.ts build",
    "content:watch": "vite-node packages/content/bin/content.ts watch",
    "content:docs": "vite-node packages/content/bin/content.ts docs",
    "assets:check": "vite-node packages/asset-contract/src/check.ts",
    "assets:city": "vite-node packages/asset-contract/tools/generate-city.ts",
    "assets:cues": "vite-node packages/asset-contract/tools/generate-cues.ts",
    "assets:racers": "vite-node packages/asset-contract/tools/generate-racers.ts",
    "assets:palette": "vite-node packages/asset-contract/tools/generate-palette.ts",
    "assets:quantize": "vite-node packages/asset-contract/tools/quantize.ts",
    "assets:generate": "vite-node packages/asset-contract/tools/generate-pixellab.ts",
    "assets:images": "vite-node packages/asset-contract/tools/generate-images.ts",
    "assets:portraits": "vite-node packages/asset-contract/tools/generate-portraits.ts",
    "assets:sounds": "vite-node packages/asset-contract/tools/generate-sounds.ts",
    "assets:measure": "vite-node packages/asset-contract/tools/measure-audio.ts",
    "assets:covers": "vite-node packages/asset-contract/tools/generate-covers.ts",
    "intake:song": "vite-node packages/asset-contract/tools/intake-song-cli.ts",
    "assets:placeholder": "vite-node packages/asset-contract/tools/generate-placeholder.ts",
    "assets:stills": "vite-node packages/content/bin/compose-stills.ts",
    "demos:capture": "playwright test tests/e2e/demo-capture.spec.ts --project=desktop --workers=1 --trace off",
    "demos:encode": "vite-node tools/demos/encode.ts",
    "assets:sync": "vite-node packages/asset-contract/tools/sync-client-assets.ts",
    "screens:look": "vite-node tools/screens-look.ts",
    "e2e:serve": "node tools/e2e-serve.ts",
    "e2e:server": "PORT=${E2E_SERVER_PORT:-4100} FLOOR_FIFTY_TRANSPORT=colyseus FLOOR_FIFTY_TEST_DRIVER_TOKEN=e2e-driver-token FLOOR_FIFTY_TEST_SEED=13 pnpm --filter @floor-fifty/server exec vite-node src/main.ts",
    "e2e:client": "VITE_VISUAL_INSPECTION=1 VITE_TRANSPORT=colyseus VITE_SERVER_URL=http://127.0.0.1:${E2E_SERVER_PORT:-4100} pnpm --filter @floor-fifty/client build && pnpm --filter @floor-fifty/client preview"
  },
  "devDependencies": {
    "@colyseus/core": "^0.18.18",
    "@colyseus/schema": "^5.0.36",
    "@colyseus/sdk": "^0.18.5",
    "@colyseus/testing": "^0.18.6",
    "@colyseus/tools": "^0.18.7",
    "@floor-fifty/asset-contract": "workspace:*",
    "@floor-fifty/content": "workspace:*",
    "@floor-fifty/shared": "workspace:*",
    "@inlang/paraglide-js": "^2.25.4",
    "@inlang/plugin-message-format": "^4.4.4",
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^22.10.2",
    "@types/pngjs": "^6.0.5",
    "fontkit": "^2.0.4",
    "gsap": "^3.15.0",
    "jsdom": "^25.0.1",
    "oxlint": "^1.94.0",
    "pixi.js": "^8.21.0",
    "pngjs": "^7.0.0",
    "smol-toml": "^1.9.0",
    "subset-font": "^2.9.0",
    "svelte": "^5.57.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^6.4.6",
    "vite-node": "^3.2.4",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
