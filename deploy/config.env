# The one place the studio's domain is written (release readiness spec §3.5).
# Not secret. Every deploy file reads it from here.
# Staging: staging.$FF_DOMAIN (client), staging-api.$FF_DOMAIN (server).
FF_DOMAIN=floorfifty.duckdns.org
# Where Let's Encrypt sends certificate notices. A personal address, so it is
# not kept in the repo: export FF_ACME_EMAIL before running deploy/bin/provision-prod.
FF_ACME_EMAIL="${FF_ACME_EMAIL:-}"
