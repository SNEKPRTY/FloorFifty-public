#!/usr/bin/env bash
# Sets every workspace package to one version, the next release's, before
# its tag is cut. The title shows the client's (src/lib/version.ts), and
# check-version holds a release to it.
#
# Usage: bump-version <x.y.z | x.y.z-rc.N>
# A release candidate (x.y.z-rc.N) is staged and drilled before its x.y.z.
set -euo pipefail

version="${1:?usage: bump-version <x.y.z | x.y.z-rc.N>}"
if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-rc\.[0-9]+)?$ ]]; then
  echo "'$version' is not a version: x.y.z or x.y.z-rc.N, with no v" >&2
  exit 2
fi
cd "$(git rev-parse --show-toplevel)"
for file in package.json apps/*/package.json packages/*/package.json; do
  [[ -f "$file" ]] || continue
  # The version line alone, so the file keeps its own layout.
  VERSION="$version" node -e '
    const fs = require("fs");
    const file = process.argv[1];
    const text = fs.readFileSync(file, "utf8");
    const next = text.replace(/^(\s*"version":\s*)"[^"]*"/m, `$1"${process.env.VERSION}"`);
    if (next === text && !text.includes(`"version": "${process.env.VERSION}"`)) {
      console.error(`${file} has no version`);
      process.exit(1);
    }
    fs.writeFileSync(file, next);
  ' "$file"
done
echo "every package is at $version; commit it, then cut v$version"
